# =============================================================
# whhw-new 환경변수 예시 (실제 값 없음 — 키 목록·용도 참조용)
# claude.ai/code 클라우드 환경 또는 로컬 .env.local 설정 시 참고.
# 실제 값은 절대 커밋 금지. 로컬은 .env.local, 클라우드는 environment 변수 UI 사용.
# =============================================================

# ── 필수: Supabase (DB·인증) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용(RLS 우회) — 절대 클라이언트 노출 금지

# ── 필수: AI (SF 산출·질환학습 성분설명 등) ──────────────
ANTHROPIC_API_KEY=

# ── 선택: 추가 AI ────────────────────────────────────────
OPENAI_API_KEY=

# ── 선택: 외부 공공 API (의약품·심평원·식약처) ───────────
DRUG_API_KEY=                       # 의약품 정보
HIRA_API_KEY=                       # 심평원(HIRA)
MFDS_API_KEY=                       # 식약처(MFDS)
MEDICAL_API_KEY=                    # 의료기관 정보

# ── 선택: 메일 발송(Gmail) ───────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── 선택: 기타 ───────────────────────────────────────────
CRON_SECRET=                        # cron 엔드포인트 보호용 시크릿
NEXT_PUBLIC_NEWS_URL=               # 업계동향 뉴스 소스 URL

# =============================================================
# 클라우드(claude.ai/code) 최소 빌드 구성:
#   NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY /
#   SUPABASE_SERVICE_ROLE_KEY / ANTHROPIC_API_KEY
# 나머지는 해당 기능을 클라우드에서 실행할 때만 추가.
# =============================================================
